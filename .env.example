# Explicit preview simulation. There is no real charge or ad in this mode.
# EAS production profile overrides this with production.
EXPO_PUBLIC_PROVIDER_MODE=mock

# Match the real product configured in App Store Connect / Google Play / RevenueCat.
# The development mock also uses this ID and reports DEV · FREE TEST as its price.
EXPO_PUBLIC_STARTER_PACK_PRODUCT_ID=starter_pack
EXPO_PUBLIC_STARTER_PACK_ENTITLEMENT_ID=starter_pack

# Configure only for a native SDK build; leave blank for the offline mock preview.
# App IDs use ~; rewarded unit IDs use /. Obtain platform-specific values from AdMob.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_UNIT_ID=
EXPO_PUBLIC_ADMOB_IOS_REWARDED_UNIT_ID=

# RevenueCat PUBLIC mobile SDK API keys, not secret REST API keys.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# EXPO_PUBLIC_* values are bundled into the client and are not secrets.
# Never put service-role keys, signing credentials, or store secrets here.
# Production bridges are selected automatically in native builds when configured.
# Rebuild native code after changing AdMob App IDs/config plugins.
# Web builds deliberately exclude native monetization SDKs.
# Analytics is disabled until configureAnalytics() receives an initialized adapter.
# See src/services/README.md and docs/EXTERNAL_BLOCKERS.md.

# Optional telemetry. Disabled by default; public project values only.
EXPO_PUBLIC_OBSERVABILITY_ENABLED=false
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
